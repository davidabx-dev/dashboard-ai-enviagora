# =========================================================================
# 🔐 MODELO DE VARIÁVEIS DE AMBIENTE - DASHBOARD AI ENVIAGORA
# =========================================================================
# Instruções:
# 1. Copie este arquivo e renomeie para `.env.local`
# 2. Substitua os valores de exemplo abaixo pelas suas credenciais reais
# 3. NUNCA envie o seu arquivo `.env.local` para o GitHub
# =========================================================================

# 🧠 Motor de IA James (Groq Cloud)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY="sua_chave_groq_aqui"

# 📊 Integração Google Sheets (Google Cloud Service Account)
# Crie uma Service Account no Google Cloud Console com permissão de Editor na Planilha
GOOGLE_SERVICE_ACCOUNT_EMAIL="seu-servico@seu-projeto.iam.gserviceaccount.com"

# Chave Privada RSA da Service Account (mantenha entre aspas duplas com os \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSEU_CONTEUDO_DA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----"

# ID da Planilha Google (encontrado na URL: https://docs.google.com/spreadsheets/d/ID_DA_PLANILHA/edit)
GOOGLE_SHEET_ID="seu_id_de_planilha_google_aqui"
